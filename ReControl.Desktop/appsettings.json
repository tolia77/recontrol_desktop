{
  // Shipped defaults = production. Debug builds also copy appsettings.Development.json
  // (see the csproj None Update items), which overrides these values locally.
  // A matching environment variable -- API_BASE_URL, WS_URL, FRONTEND_URL, LOG_LEVEL --
  // overrides both, so a build can still be pointed at another server without a rebuild.
  "ReControl": {
    "ApiBaseUrl": "https://port3003.kokhan.me",
    "WsUrl": "wss://port3003.kokhan.me/cable",

    // Web UI base for the "sign up" link. Omitted here: it falls back to ApiBaseUrl.
    // "FrontendUrl": "",

    // Minimum log level recorded (Logs tab + file): debug | info | warn | error.
    // Unset = debug (record everything). warn keeps the hot path lean in production --
    // the per-event Info logging during streaming (ICE candidates, command dispatch)
    // is a synchronous file append per call.
    "LogLevel": "warn"
  }
}
